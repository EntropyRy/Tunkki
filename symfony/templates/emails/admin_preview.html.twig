{# admin_preview.html.twig #}
{% extends 'emails/base.html.twig' %}
{% block content %}
    <div>{{ body|markdown_to_html|raw }}</div>
    {% if qr is not null %}
        <hr>
        <img style="max-width: 100%" src="data:image/png;base64,{{ qr }}">
    {% endif %}
{% endblock %}
{% block admin_send %}
    {% if (admin is defined and admin.isChild and qr is null) or (email.purpose is not null and email.purpose.canBeSentFromStandaloneAdmin()) %}
        <style>
          .button {
            background-color: #4CAF50;
            border: 2px solid #000;
            color: white;
            padding: 15px 32px;
            text-align: center;
            text-decoration: none;
            display: block;
            font-size: 16px;
            width: 80%;
            margin: 40px auto;
          }
          .progress {
            width: 80%;
            margin: 20px auto;
            display: none;
          }
          .progress-bar {
            height: 20px;
            background-color: #4CAF50;
            width: 0%;
            transition: width 0.5s;
          }
          p.info {
            text-align: center;
            margin: 40px auto;
          }
        </style>

        <p class="info">Every email costs us. Please do not send emails at night time as people do not get notifications about them.</p>
        <button class="button" id="sendEmails"
                data-url="{{ admin.generateObjectUrl('send', email) }}"
                data-progress-url="{{ admin.generateObjectUrl('send_progress', email) }}">
            Send mails
        </button>

        <div class="progress" id="emailProgress">
            <div class="progress-bar" role="progressbar"></div>
            <p class="text-center" id="progressText">0%</p>
        </div>
        <script>
            document.getElementById('sendEmails').addEventListener('click', function(e) {
                e.preventDefault();
                const button = this;
                const progressDiv = document.getElementById('emailProgress');
                const progressBar = progressDiv.querySelector('.progress-bar');
                const progressText = document.getElementById('progressText');
                const sendUrl = button.dataset.url;
                const progressUrl = button.dataset.progressUrl;

                // Disable button and show progress
                button.disabled = true;
                button.textContent = 'Sending...';
                progressDiv.style.display = 'block';

                let finished = false;
                const finish = (text, redirectUrl) => {
                    if (finished) {
                        return;
                    }
                    finished = true;
                    progressText.textContent = text;
                    if (redirectUrl) {
                        setTimeout(() => {
                            window.location.href = redirectUrl;
                        }, 1500);
                    }
                };

                // Start the email sending process; its response is authoritative
                fetch(sendUrl, {
                    method: 'POST',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest',
                        'Cache-Control': 'no-cache'
                    },
                    credentials: 'same-origin'
                })
                .then(response => {
                    if (!response.ok) {
                        throw new Error('Network response was not ok');
                    }
                    return response.json();
                })
                .then(data => {
                    if (data.success) {
                        progressBar.style.width = '100%';
                        finish(`${data.count} emails sent - Complete! Redirecting...`, data.redirectUrl);
                    } else {
                        finish('Error: ' + (data.error || 'unknown error') + ' - Redirecting...', data.redirectUrl);
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    finish('Error occurred: ' + error.message, null);
                });

                // Poll progress while the send request is running
                let checkProgress = function() {
                    if (finished) {
                        return;
                    }
                    fetch(progressUrl, {
                        headers: {
                            'Cache-Control': 'no-cache',
                            'Pragma': 'no-cache'
                        },
                        credentials: 'same-origin'
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (finished) {
                            return;
                        }
                        if (data.total === 0) {
                            progressText.textContent = 'Preparing to send emails...';
                        } else {
                            const percent = Math.round((data.current / data.total) * 100);
                            progressBar.style.width = percent + '%';
                            progressText.textContent = `${data.current} / ${data.total} emails sent (${percent}%)`;
                        }

                        // Keep polling until the send request resolves
                        setTimeout(checkProgress, 1000);
                    })
                    .catch(error => {
                        console.error('Error fetching progress:', error);
                        setTimeout(checkProgress, 2000); // Try again after 2 seconds
                    });
                };

                setTimeout(checkProgress, 1000);
            });
        </script>
    {% endif %}
{% endblock %}
