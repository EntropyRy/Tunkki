{% extends event.template %}
{% block event_section_name %}{{ 'event.section.info'|trans }}{% endblock %}
{% block content %}
    {{ block('event_heading') }}
    {% set input = template_from_string(event.contentForTwig(app.request.locale)) %}
    <div class="content">
        {{ block('content_info', input) ?? '' }}
    </div>
    {{ block('event_back_to_link') }}
{% endblock %}
