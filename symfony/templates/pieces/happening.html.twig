{%- block happening_list -%}
{%- if event.url -%}
{%- set released = event.happenings|filter(h => h.releaseThisHappeningInEvent == true) -%}
{%- set owned_unreleased = event.happenings|filter(h => h.releaseThisHappeningInEvent == false and app.user and app.user.member in h.owners) -%}
{%- set visible_happenings = (released|merge(owned_unreleased))|sort((a, b) => a.time <=> b.time) -%}
{%- set whole_event_happenings = visible_happenings|filter(h => h.entireEvent == true) -%}
{%- set timed_happenings = visible_happenings|filter(h => h.entireEvent == false) -%}
<div class="pt-2 pb-2 col-12" id="happening_list">
{{- block('happening_whole_event_list') -}}
{{- block('happening_timetable') -}}
{%- if event.allowMembersToCreateHappenings and app.user -%}
{%- if visible_happenings|length > 0 %}<hr>{% endif -%}
<a class="btn btn-success text-white w-50 mx-auto mt-2 d-block mx-auto"
   href="{{- path('entropy_event_happening_create', {slug: event.url, year: event.eventdate|date('Y')}) }}">{{ 'happening.create'|trans -}}</a>
{%- endif -%}
</div>
{%- endif -%}
{%- endblock -%}
{%- block happening_link -%}
{%- set is_private = happening.releaseThisHappeningInEvent == false -%}
<a class="btn text-white w-100 btn-lg {{ is_private ? 'btn-danger' : 'btn-info' }} happening-type-{{ happening.type }}"
   target="_top"
   href="{{ path('entropy_event_happening_show', {slug: event.url, year: event.eventdate|date('Y'), happeningSlug: happening.slug(app.request.locale)}) }}">
{{- happening.name(app.request.locale) -}}
{%- if happening.endTime %} <small>(–{{ happening.endTime|format_datetime(pattern: 'HH:mm') }})</small>{% endif -%}
{%- if happening.needsPreliminarySignUp %} ( {{ happening.bookings|length }}/{{ happening.maxSignUps }} ){% endif -%}
{%- if is_private %}{{ block('shown_only_to') }}{% endif -%}
</a>
{%- endblock -%}
{%- block happening_whole_event_list -%}
{%- if whole_event_happenings|length > 0 -%}
<div class="pb-3 col-12">
<h4 class="happening-entire-event-heading">{{ 'happening.entire_event_label'|trans }}</h4>
<div{% if whole_event_happenings|length > 1 %} class="happening-button-group"{% endif %}>
{%- for happening in whole_event_happenings -%}
{{ block('happening_link') }}
{%- endfor -%}
</div>
</div>
{%- endif -%}
{%- endblock -%}
{%- block happening_timetable -%}
{%- if timed_happenings|length > 0 -%}
{%- set happening_groups = timed_happenings|group_happenings_by_time -%}
{%- set now = 'now'|date('U') -%}
{%- set event_until = event.until|date('U') -%}
{%- set unix_times = happening_groups|map(g => g.time|date('U')) -%}
{%- set first_start_unix = (happening_groups|first).time|date('U') -%}
{%- set show_indicator = now >= first_start_unix and now <= event_until -%}
<table class="timetable happening-timetable"
{%- if show_indicator -%}
{{- stimulus_controller('time-indicator', {
    'server-time': 'now'|date('c'),
    'event-start': (happening_groups|first).time|date('c'),
    'event-end': event.until|date('c'),
    'slot-times': unix_times|join(','),
}) -}}
{%- endif -%}
>
<tbody>
{%- set indicator_added = false -%}
{%- set last_day = null -%}
{%- for group in happening_groups -%}
{%- set current_day = group.time|date('Y-m-d') -%}
{%- if event.multiday == true and current_day != last_day -%}
<tr class="time-gap happening-day-separator">
<td colspan="3"><span class="gap-chip">{{ group.time|format_datetime(pattern: 'E d.M.') }}</span></td>
</tr>
{%- endif -%}
{%- set last_day = current_day -%}
<tr>
{%- set will_add_indicator_target = show_indicator and (not indicator_added) -%}
<td class="indicator"
{%- if will_add_indicator_target -%}
{{ stimulus_target('time-indicator', 'indicator') }}
{%- endif -%}
>
{%- if will_add_indicator_target -%}
{{ 'timetable.now'|trans }} <twig:ux:icon name="arrow-right" height="1em" />
{%- endif -%}
</td>
{%- if will_add_indicator_target %}{% set indicator_added = true %}{% endif -%}
<td class="time">{{ group.time|format_datetime(pattern: 'HH:mm') }}</td>
<td class="happening-info{% if group.happenings|length > 1 %} happening-button-group{% endif %}">
{%- for happening in group.happenings -%}
{{- block('happening_link') -}}
{%- endfor -%}
</td>
</tr>
{%- endfor -%}
</tbody>
</table>
{%- endif -%}
{%- endblock -%}
{% block shown_only_to %}
    {{ 'happening.shown_only_to'|trans }}
    {% for member in happening.owners %}
        {{ member.username }}{% if not loop.last %},{% endif %}
    {% endfor %}
{% endblock %}
{% block prev_next_navigation %}
    {% if prev or next %}
        {% if prev %}
            <a href="{{ path('entropy_event_happening_show', {slug: event.url, year: event.eventdate|date('Y'), happeningSlug: prev.slug(app.request.locale)}) }}"
               class="btn btn-secondary"><twig:ux:icon name="arrow-left" /> {{ prev.name(app.request.locale) }}</a>
        {% else %}
            <button class="btn btn-secondary disabled">
                <twig:ux:icon name="ban" />
            </button>
        {% endif %}
        {% if next %}
            <a href="{{ path('entropy_event_happening_show', {slug: event.url, year: event.eventdate|date('Y'), happeningSlug: next.slug(app.request.locale)}) }}"
               class="btn btn-secondary float-end">{{ next.name(app.request.locale) }} <twig:ux:icon name="arrow-right" /></a>
        {% else %}
            <button class="btn btn-secondary disabled float-end">
                <twig:ux:icon name="ban" />
            </button>
        {% endif %}
    {% endif %}
{% endblock %}
{% block happening_info %}
    {% set eventInPast = eventTemporalState.isInPast(event) %}
    {% set name = happening.name(app.request.locale) %}
    {% set space_left = happening.maxSignUps - happening.bookings|length %}
    {% if event.happenings|length > 1 %}
        <div class="row mb-3">
            <div class="col-12">{{ block('prev_next_navigation') }}</div>
        </div>
    {% endif %}
    <div class="row">
        <div class="col-12">
            <h1>
                <a href="{{ path('entropy_event_slug', {slug: event.url, year: event.eventdate|date('Y')}) }}">{{ event.name }}</a> ~
                {{ ('happening.type.' ~ happening.type)|trans }}
                {% if admin and not eventInPast %}
                    ~ <a class="btn btn-lg btn-success"
    href="{{ path('entropy_event_happening_edit', {slug: event.url, year: event.eventdate|date('Y'), happeningSlug: happening.slug(app.request.locale)}) }}">{{ 'happening.edit'|trans }}</a>
                {% endif %}
                {% if happening.releaseThisHappeningInEvent == false %}
                    ~ <span class="text-danger">{{ block('shown_only_to') }}</span>
                {% endif %}
            </h1>
        </div>
    </div>
    <div class="row">
        {% if happening.picture %}
            <div class="col-sm-6 col-md-4">{{ block('happening_pic') }}</div>
            <div class="col-sm-6 col-md-8 mt-4 mt-sm-0">
            {% else %}
                <div class="col-12 mt-4 mt-sm-0">
                {% endif %}
                <h3>
                    {{ name }}
                    <small>
                        {%- if happening.entireEvent -%}
                            {{ 'happening.entire_event_label'|trans }}
                        {%- else -%}
                            {{- happening.time|format_datetime(pattern: 'E, HH:mm') -}}
                            {%- if happening.endTime %}–{{ happening.endTime|format_datetime(pattern: 'HH:mm') }}{% endif -%}
                        {%- endif -%}
                    </small>
                </h3>
                <p>{{ description|raw }}</p>
                {% if happening.needsPreliminaryPayment and not eventInPast %}
                    <hr>
                    <h4>{{ 'happening.paymentInfo'|trans }}</h4>
                    <div class="happening-payment-info">
                        {{ payment_info|replace({
                                                '{{ ticket_ref }}': ticket_ref,
                                                })|raw }}
                    </div>
                    <h5>{{ 'happening.field.price'|trans }}</h5>
                    <p>{{ happening.price(app.request.locale) }}</p>
                {% endif %}
            </div>
            {% if not eventInPast %}
                <div class="col-12 mt-4">
                    {% if happening.needsPreliminarySignUp %}
                        {% if happening.signUpsAreOpen %}
                            <h4>{{ space_left }} {{ 'happening.seats_available'|trans }}</h4>
                            {% if happeningB.member == app.user.member %}
                                {% if happeningB.comment %}
                                    <p>{{ 'happening.reservation_with_comment'|trans }}: {{ happeningB.comment }}</p>
                                {% endif %}
                                <div>
                                    <a data-turbo="false" href="{{ path('entropy_event_happening_remove', {id: happeningB.id}) }}"
                                       class="w-100 btn btn-warning">{{ 'happening.remove_reservation'|trans }}</a>
                                </div>
                            {% else %}
                                {{ form_start(form) }}
                                    {{ form_widget(form) }}
                                    <input class="btn btn-primary w-100"
                                           type="submit"
                                           value="{{ 'happening.sign_up'|trans|capitalize }}">
                                {{ form_end(form) }}
                            {% endif %}
                        {% else %}
                            <h4>
                                {{ space_left }} {{ 'happening.seats_available'|trans }},
                                {{ 'happening.sign_ups_have_ended'|trans }}
                            </h4>
                            {% for booking in happening.bookings %}
                                {% if booking.member == app.user.member %}
                                    <p class="text-success">{{ 'happening.reservation_with_comment'|trans }}: {{ booking.comment }}</p>
                                {% endif %}
                            {% endfor %}
                        {% endif %}
                    {% endif %}
                    {% if happening.needsPreliminarySignUp and admin %}
                        <div class="row mt-4">
                            <div class="col-12">
                                <h4>{{ 'happening.bookings'|trans }} {{ 'happening.bookings_for_admin'|trans }}</h4>
                                <ol>
                                    {% for booking in happening.bookings %}
                                        <li>
                                            {{ booking.member.username }}, {{ booking.member }}
                                            {% if booking.comment %}: {{ booking.comment }}{% endif %}
                                        </li>
                                    {% else %}
                                        <span>{{ 'happening.no_reservations'|trans }}</span>
                                    {% endfor %}
                                </ol>
                            </div>
                        </div>
                    {% endif %}
                </div>
            {% endif %}
        </div>
        {% if event.happenings|length > 1 %}
            <div class="row mt-3">
                <div class="col-12">{{ block('prev_next_navigation') }}</div>
            </div>
        {% endif %}
    {% endblock %}
    {% block happening_pic %}
        <span class="polaroid">
            {% if happening.picture %}
                <img width="100%"
                     loading="lazy"
                     title="{{ name }}"
                     src="{{ sonata_path(happening.picture, 'square') }}">
            {% endif %}
            <div class="caption d-none d-sm-block">{{ name }}</div>
        </span>
    {% endblock %}
