{% block sonata_media_type_row %}
    {% if compound is defined and compound %}
        {% set element = 'fieldset' %}
    {% endif %}
    {% set row_class = row_class|default(row_attr.class|default('mb-3')|trim) %}
    <{{ element|default('div') }}{% with {attr: row_attr|merge({class: row_class})} %}{{ block('attributes') }}{% endwith %}>
        {{ form_label(form) }}
        {% if id == 'artist_Picture' and errors|length > 0 %}
            {{ form_widget(form, {attr: {'aria-describedby': id ~ '_error1'}}) }}
        {% else %}
            {{ form_widget(form, widget_attr|default({})) }}
        {% endif %}
        {{ form_help(form) }}
        {% if id == 'artist_Picture' and errors|length > 0 %}
            <div class="invalid-feedback d-block" id="{{ id }}_error1">{{ (errors|first).message }}</div>
        {% else %}
            {{ form_errors(form) }}
        {% endif %}
    </{{ element|default('div') }}>
{% endblock sonata_media_type_row %}

{% block sonata_media_type_widget %}
    <div class="row">
        <div class="col-12 col-md-4">
            {% if value is not empty and value.providerReference %}
                <div style="margin-right: 5px">
                    <div class="polaroid">
                        <img width="100%"
                             title="{{ name }}"
                             src="{{ sonata_path(value, 'square') }}">
                        <div class="caption">
                            <strong>{{ value.name }}</strong>
                        </div>
                    </div>
                </div>
            {% else %}
                <div style="margin-right: 5px">
                    <div class="polaroid">
                        <img src="{{ asset('images/thumb_artist_square.jpg') }}" style="width: 100%" title="Placeholder Image" />
                        <div class="caption">
                            <strong>{{ 'no_linked_media'|trans }}</strong>
                        </div>
                    </div>
                </div>
            {% endif %}
        </div>
        <div class="col-12 col-md-8">
            <strong>{{ 'link_media'|trans }}</strong>
            {{ block('form_widget') }}
            {{ form_errors(form.binaryContent) }}
        </div>
    </div>
{% endblock sonata_media_type_widget %}
